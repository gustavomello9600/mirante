# Copie para .env e preencha apenas o que precisar.
# NUNCA versione .env: ele contém segredos e já está no .gitignore.
#
# O backend funciona sem chave de LLM, em modo extrativo.

# --- Servidor ---
MIRANTE_PORT=8091
MIRANTE_DB=./data/mirante.db
MIRANTE_DIST=../frontend/dist
MIRANTE_CACHE_TTL=1800

# --- Leitura profunda ---
# Abre a íntegra de algumas matérias para enriquecer o relance.
MIRANTE_FULLTEXT_ENABLED=true
MIRANTE_FULLTEXT_MAX=12

# --- LLM (opcional) ---
# none | openrouter | openai | mock
MIRANTE_LLM_PROVIDER=none
MIRANTE_LLM_API_KEY=
MIRANTE_LLM_MODEL=openai/gpt-4o-mini
MIRANTE_LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Identificação e diagnóstico ---
# User-Agent enviado aos veículos. O padrão aponta para o repositório.
# MIRANTE_USER_AGENT=Mirante/0.1 (+https://example.com; leitor de cobertura)
# URL pública usada como HTTP-Referer no OpenRouter.
# MIRANTE_PUBLIC_URL=https://news.example.com
# Expõe detalhes técnicos de erros 500 na API. Use só em desenvolvimento.
MIRANTE_DEBUG=false
