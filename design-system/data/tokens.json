{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Mirante",
  "version": "0.1.0",
  "description": "Tokens do Mirante Design System. Fonte da verdade em CSS: styles/tokens.css.",
  "color": {
    "paper": { "light": "#F4F3ED", "dark": "#11120F" },
    "paperRaised": { "light": "#FBFAF5", "dark": "#181914" },
    "paperSunken": { "light": "#ECEAE2", "dark": "#0C0D0A" },
    "ink": { "light": "#151611", "dark": "#F1EFE6" },
    "inkSoft": { "light": "#3E3F37", "dark": "#D0CDC0" },
    "muted": { "light": "#6E6D63", "dark": "#A3A094" },
    "faint": { "light": "#9B998D", "dark": "#77756B" },
    "rule": { "light": "#D8D5C8", "dark": "#2C2D26" },
    "ruleStrong": { "light": "#BDB9AA", "dark": "#44453B" },
    "brand": { "light": "#2438E8", "dark": "#8B9BFF" },
    "brandInk": { "light": "#F7F6EF", "dark": "#101118" },
    "brandSoft": { "light": "#E5E7FB", "dark": "#1D2140" },
    "accent": { "light": "#A9503B", "dark": "#D98B72" },
    "accentSoft": { "light": "#F3E4DE", "dark": "#2D1E19" },
    "biasLeft": { "light": "#3F5FA8", "dark": "#8FA9E8" },
    "biasCenter": { "light": "#8B887B", "dark": "#B5B1A3" },
    "biasRight": { "light": "#A9503B", "dark": "#D98B72" },
    "biasUnknown": { "light": "#C6C2B4", "dark": "#55564C" },
    "factHigh": { "light": "#2F6B4F", "dark": "#7FBF9A" },
    "factMixed": { "light": "#7E5714", "dark": "#D8B36A" },
    "factLow": { "light": "#A33A32", "dark": "#E28B80" },
    "success": { "light": "#2F6B4F", "dark": "#7FBF9A" },
    "warning": { "light": "#7E5714", "dark": "#D8B36A" },
    "danger": { "light": "#A33A32", "dark": "#E28B80" }
  },
  "font": {
    "display": "Instrument Serif",
    "body": "Literata",
    "ui": "Schibsted Grotesk"
  },
  "fontSize": {
    "displayXl": "clamp(4.75rem, 10vw, 9rem)",
    "displayL": "clamp(3.5rem, 6.5vw, 6rem)",
    "displayM": "clamp(2.75rem, 4.6vw, 4.25rem)",
    "headline": "clamp(2rem, 3.2vw, 2.75rem)",
    "title": "1.5rem",
    "lede": "1.375rem",
    "body": "1.1875rem",
    "bodyS": "1.0625rem",
    "ui": "0.9375rem",
    "small": "0.8125rem",
    "caption": "0.75rem",
    "micro": "0.65625rem"
  },
  "lineHeight": {
    "display": 0.94,
    "displayL": 0.96,
    "headline": 1.04,
    "title": 1.18,
    "lede": 1.45,
    "body": 1.66,
    "ui": 1.35,
    "caption": 1.4
  },
  "tracking": {
    "display": "-0.035em",
    "headline": "-0.02em",
    "title": "-0.015em",
    "body": "0",
    "ui": "0.005em",
    "caps": "0.08em"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px",
    "40": "160px"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  },
  "layout": {
    "container": "1440px",
    "containerNarrow": "1088px",
    "measure": "66ch",
    "measureTight": "58ch",
    "measureReport": "68ch",
    "gridColumns": 12
  },
  "motion": {
    "durationFast": "140ms",
    "durationBase": "220ms",
    "durationSlow": "420ms",
    "easeOut": "cubic-bezier(0.2, 0, 0, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)"
  },
  "shadow": {
    "menu": "0 18px 48px -18px rgb(21 22 17 / 0.25), 0 2px 6px -2px rgb(21 22 17 / 0.12)",
    "float": "0 8px 24px -14px rgb(21 22 17 / 0.22)"
  }
}
